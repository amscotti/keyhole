# Secrets referenced from config.toml auth profiles as ${VAR} are resolved
# from the environment at load time. They are NEVER written to logs.
#
# `export` so this file works as `source .env.example` in the README quickstart.
# Used by config.example.toml's example auth profiles — replace with real tokens.
export KEYHOLE_GITHUB_TOKEN=ghp_example_token
export KEYHOLE_INTERNAL_TOKEN=example_internal_token
